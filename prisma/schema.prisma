generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(cuid())
  clerkId           String              @unique
  email             String
  name              String?
  activeWorkspaceId String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  actions           Action[]
  actionPlans       ActionPlan[]
  activeWorkspace   Workspace?          @relation("ActiveWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)
  contacts          Contact[]
  executionLogs     ExecutionLog[]
  idempotencyKeys   IdempotencyKey[]
  integrations      Integration[]
  messages          Message[]
  ownedWorkspaces   Workspace[]         @relation("WorkspaceOwner")
  rateLimitBuckets  RateLimitBucket[]
  subscription      Subscription?
  memberships       WorkspaceMembership[]
}

model Workspace {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  ownerId         String
  preferences     Json?
  actions         Action[]
  actionPlans     ActionPlan[]
  activeUsers     User[]              @relation("ActiveWorkspace")
  contacts        Contact[]
  executionLogs   ExecutionLog[]
  idempotencyKeys IdempotencyKey[]
  integrations    Integration[]
  messages        Message[]
  owner           User                @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  rateLimitBuckets RateLimitBucket[]
  memberships     WorkspaceMembership[]
}

model Message {
  id          String    @id @default(cuid())
  content     String
  role        String
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspaceId String
  userId      String
  action      Action?
  actionPlan  ActionPlan?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Action {
  id            String         @id @default(cuid())
  type          String
  title         String
  description   String
  parameters    Json
  status        String         @default("pending")
  result        Json?
  executedAt    DateTime?
  /// When set, a cron job sends `send_email` at or after this time (user already approved).
  scheduledFor  DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  workspaceId   String
  userId        String
  planId        String?
  planStepIndex Int?
  messageId     String?        @unique
  message       Message?       @relation(fields: [messageId], references: [id])
  plan          ActionPlan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executionLogs ExecutionLog[]

  @@index([workspaceId, userId, status, createdAt])
  @@index([workspaceId, userId, updatedAt])
  @@index([planId, planStepIndex])
  @@index([status, scheduledFor])
}

model Integration {
  id            String         @id @default(cuid())
  type          String
  accessToken   String
  refreshToken  String?
  expiresAt     DateTime?
  metadata      Json?
  status        String         @default("disconnected")
  lastSyncAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  workspaceId   String
  userId        String
  executionLogs ExecutionLog[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, type])
  @@index([workspaceId, userId, status])
}

model ExecutionLog {
  id            String       @id @default(cuid())
  actionType    String
  status        String
  details       Json?
  error         String?
  createdAt     DateTime     @default(now())
  workspaceId   String
  userId        String
  actionId      String?
  integrationId String?
  action        Action?      @relation(fields: [actionId], references: [id])
  integration   Integration? @relation(fields: [integrationId], references: [id])
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, createdAt])
  @@index([workspaceId, userId, actionType])
  @@index([actionId])
}

model Contact {
  id          String    @id @default(cuid())
  name        String
  email       String
  aliases     Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspaceId String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, email])
}

model ActionPlan {
  id          String           @id @default(cuid())
  summary     String
  status      String           @default("pending_review")
  metadata    Json?
  currentStepIndex Int         @default(0)
  nextResumeAt DateTime?
  lastResumedAt DateTime?
  lastError   String?
  executionMode String         @default("ask")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspaceId String
  userId      String
  messageId   String?          @unique
  actions     Action[]
  message     Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  steps       ActionPlanStep[]
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, updatedAt])
  @@index([status, updatedAt])
  @@index([nextResumeAt, status])
}

model ActionPlanStep {
  id        String     @id @default(cuid())
  title     String
  detail    String
  app       String?
  kind      String     @default("action")
  status    String     @default("pending")
  metadata  Json?
  waitUntil DateTime?
  retryCount Int       @default(0)
  retryLimit Int       @default(2)
  retryBackoffSeconds Int @default(300)
  lastError String?
  startedAt DateTime?
  completedAt DateTime?
  stepIndex Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  planId    String
  plan      ActionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, stepIndex])
  @@index([planId, status])
}

model WorkspaceMembership {
  id          String    @id @default(cuid())
  role        String    @default("viewer")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspaceId String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, role])
}

model IdempotencyKey {
  id             String    @id @default(cuid())
  namespace      String
  key            String
  fingerprint    String
  status         String    @default("pending")
  responseStatus Int?
  responseBody   Json?
  responseHeaders Json?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspaceId    String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([namespace, workspaceId, userId, key])
  @@index([expiresAt])
}

model RateLimitBucket {
  id          String    @id @default(cuid())
  namespace   String
  clientKey   String
  windowStart DateTime
  limit       Int
  count       Int       @default(0)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspaceId String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([namespace, workspaceId, userId, clientKey, windowStart])
  @@index([expiresAt])
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  plan                   String    @default("free") // free | plus | pro
  status                 String    @default("active") // active | canceled | past_due | incomplete
  currentPeriodEnd       DateTime?
  requestsUsedThisMonth  Int       @default(0)
  monthResetAt           DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
