DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_saas_starter?schema=public"
# Public origin only, no trailing slash (OAuth + Stripe return URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="OpsAgent"
APP_ENCRYPTION_KEY="replace_with_a_long_random_secret"
# Required on Vercel/production for chat: calls OpenAI gpt-4.1 (see KOVA_CHAT_MODEL in code).
OPENAI_API_KEY=""
# Usage on platform.openai.com increases when a chat turn calls the model. Default: Kova is LLM-first — the model
# reasons, drafts copy, and returns proposals. Set KOVA_PREFER_DETERMINISTIC_ACTIONS=true to use built-in shortcuts
# for some intents (no OpenAI call on those turns = lower cost; less nuance).
# Optional alias if the key is stored under another name.
# OPENAI_KEY=""
# KOVA_PREFER_DETERMINISTIC_ACTIONS="true"
# Chat / structured analysis use gpt-4.1 in code (KOVA_CHAT_MODEL). OPENAI_MODEL is not applied there.
# OPENAI_MODEL="gpt-4.1"
# Max completion tokens per turn (default 4096). Higher = more output billed if the model uses it.
# KOVA_OPENAI_MAX_OUTPUT_TOKENS="4096"
# Request timeout ms for OpenAI Responses (default 45000).
# KOVA_OPENAI_TIMEOUT_MS="45000"
# Sampling temperature for non–gpt-5 models (default 0.35). OPENAI_TEMPERATURE="0.2"
OPENAI_REASONING_EFFORT="low"
OPENAI_TEXT_VERBOSITY="medium"
KOVA_STANDALONE_SHARED_SECRET=""
KOVA_STANDALONE_WORKSPACE_ID=""
KOVA_STANDALONE_USER_ID=""
KOVA_MCP_STANDALONE_PORT="8787"

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# Google OAuth (pour Gmail + Calendar)
# Google OAuth (Gmail, Calendar, Docs, Drive, Photos). Redirect URI must be exactly:
#   {NEXT_PUBLIC_APP_URL}/api/integrations/callback/google
# If users see "Access blocked / app is in testing" (403): in Google Cloud Console →
# APIs & Services → OAuth consent screen → add their Google account under "Test users",
# OR publish the app (production; sensitive scopes often require Google verification).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_PROJECT_ID=""

# Notion OAuth
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""
NOTION_PARENT_PAGE_ID=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_PLUS=""
STRIPE_PRICE_PRO=""
CRON_SECRET=""

# Observabilité
SENTRY_DSN=""
POSTHOG_KEY=""
POSTHOG_HOST="https://app.posthog.com"
